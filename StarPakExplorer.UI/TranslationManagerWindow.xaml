<Window x:Class="StarPakExplorer.UI.TranslationManagerWindow"
        x:Name="TranslationManagerRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量翻译与补丁生成"
        Width="1400"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel Margin="14">
        <Border DockPanel.Dock="Top"
                Padding="12"
                Background="#F4F7FB"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="原模组"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBox Grid.Column="1"
                         Text="{Binding ManifestPath, Mode=OneWay}"
                         IsReadOnly="True"
                         Margin="0,0,8,8" />
                <TextBlock Grid.Column="2"
                           Text="项目"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Margin="0,0,8,8" />
                <TextBlock Grid.Column="3"
                           Text="{Binding ProjectTitle}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#43546A"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="1"
                           Text="汉化输出"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,8" />
                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="浏览..."
                            Margin="0,0,8,0"
                            Command="{Binding BrowseOutputDirectoryCommand}" />
                    <Button Content="打开目录"
                            Command="{Binding OpenOutputDirectoryCommand}" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="概览"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="{Binding ProjectSummary}"
                           VerticalAlignment="Center"
                           Foreground="#43546A"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="保存项目"
                            Margin="0,0,8,0"
                            Command="{Binding SaveProjectCommand}" />
                    <Button Content="扫描"
                            Margin="0,0,8,0"
                            Command="{Binding ScanCommand}" />
                    <Button Content="批量翻译"
                            Margin="0,0,8,0"
                            Command="{Binding TranslateCommand}" />
                    <Button Content="生成补丁"
                            Command="{Binding GenerateCommand}" />
                    <Button Content="导入已有翻译"
                            Margin="8,0,0,0"
                            Command="{Binding ImportExistingCommand}"
                            ToolTip="从输出目录中已生成的补丁回填已翻译项，避免重复翻译。" />
                </StackPanel>

                <StackPanel Grid.Row="3"
                            Grid.ColumnSpan="4"
                            Margin="0,10,0,0">
                    <ProgressBar Height="6"
                                 IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{Binding StatusMessage}"
                               Foreground="#43546A"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="#FAFAFA"
                    BorderBrush="#E3E3E3"
                    BorderThickness="1"
                    CornerRadius="6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="可翻译文件"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding FileFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Content="全选筛选项"
                                    Margin="0,0,8,0"
                                    Command="{Binding SelectFilteredFilesCommand}" />
                            <Button Grid.Column="2"
                                    Content="清除筛选项"
                                    Command="{Binding ClearFilteredFilesCommand}" />
                        </Grid>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding FilesView}"
                              SelectedItem="{Binding SelectedFile}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="选中"
                                                    Binding="{Binding IsSelected}"
                                                    Width="60" />
                            <DataGridTextColumn Header="文件"
                                                Binding="{Binding RelativePath}"
                                                Width="2*"
                                                IsReadOnly="True" />
                            <DataGridTemplateColumn Header="模式" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModeLabel}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding GenerationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding DataContext.GenerationModeOptions, Source={x:Reference TranslationManagerRoot}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="条目"
                                                Binding="{Binding EntryCount}"
                                                Width="70"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="已翻译"
                                                Binding="{Binding TranslatedCount}"
                                                Width="80"
                                                IsReadOnly="True" />
                            <DataGridTextColumn Header="待处理"
                                                Binding="{Binding PendingCount}"
                                                Width="80"
                                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#DDE3EE"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0">
                    <TabItem Header="条目">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid ItemsSource="{Binding Entries}"
                                      SelectedItem="{Binding SelectedEntry}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="280" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="80" />
                                    <DataGridTextColumn Header="原文" Binding="{Binding Original}" Width="2*" />
                                    <DataGridTextColumn Header="译文" Binding="{Binding Translated}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2"
                                    Padding="12"
                                    Background="#F7F9FC"
                                    BorderBrush="#DDE3EE"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="路径"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedPath}"
                                               Foreground="#43546A"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Row="1"
                                               Text="原文"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBox Grid.Row="1"
                                             Grid.Column="1"
                                             Text="{Binding SelectedOriginal, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Margin="0,8,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="72" />

                                    <TextBlock Grid.Row="2"
                                               Text="译文"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBox Grid.Row="2"
                                             Grid.Column="1"
                                             Text="{Binding EntryTranslationDraft, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,8,0,0"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             MinHeight="96" />

                                    <TextBlock Grid.Row="3"
                                               Text="状态"
                                               FontWeight="SemiBold"
                                               Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="3"
                                               Grid.Column="1"
                                               Text="{Binding SelectedStatus}"
                                               Foreground="#43546A"
                                               Margin="0,8,0,0" />

                                    <StackPanel Grid.Row="4"
                                                Grid.ColumnSpan="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,12,0,0">
                                        <Button Content="单条翻译"
                                                Margin="0,0,8,0"
                                                Command="{Binding TranslateCurrentEntryCommand}" />
                                        <Button Content="保存补丁"
                                                Margin="0,0,8,0"
                                                Command="{Binding SaveCurrentEntryCommand}" />
                                        <Button Content="跳过"
                                                Margin="0,0,8,0"
                                                Command="{Binding SkipCurrentEntryCommand}" />
                                        <Button Content="确认"
                                                Command="{Binding ConfirmCurrentEntryCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="引擎配置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="8">
                                <Border Padding="12"
                                        Background="#F7F9FC"
                                        BorderBrush="#DDE3EE"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="翻译引擎"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="当前引擎"
                                                       Width="84"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Width="220"
                                                      ItemsSource="{Binding EngineOptions}"
                                                      SelectedItem="{Binding SelectedEngine}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="目标语言"
                                                       Width="84"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Width="220"
                                                      ItemsSource="{Binding TargetLanguageOptions}"
                                                      Text="{Binding TargetLanguage, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" />
                                            <TextBlock Text="目标语言（BCP-47），如 zh-CN / zh-TW / ja / ko。翻译结果与全局词库将按此语言保存。"
                                                       Foreground="#667"
                                                       TextWrapping="Wrap"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="OpenAI / Google 配置会在保存项目时写入 translation_progress.json。GoogleFree（免费）无需任何配置。"
                                                   Foreground="#667"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="12"
                                        Background="#F7F9FC"
                                        BorderBrush="#DDE3EE"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="OpenAI"
                                                   Grid.ColumnSpan="3"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1"
                                                   Text="API Key"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,8" />

                                        <TextBlock Grid.Row="2"
                                                   Text="Model"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,8,0">
                                            <TextBox Width="180"
                                                     Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" />
                                            <TextBox Width="320"
                                                     Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="Base URL"
                                                   VerticalAlignment="Center"
                                                   Foreground="#667" />
                                    </Grid>
                                </Border>

                                <Border Padding="12"
                                        Background="#F7F9FC"
                                        BorderBrush="#DDE3EE"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding IsGoogleFreeNoteVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="GoogleFree（谷歌翻译免费接口）：无需 Project ID / Service Account，选择后可直接翻译。注意该接口非官方、有限流，批量翻译时自动限速并重试。"
                                               Foreground="#43546A"
                                               TextWrapping="Wrap" />
                                </Border>

                                <Border Padding="12"
                                        Background="#F7F9FC"
                                        BorderBrush="#DDE3EE"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding IsGooglePaidConfigVisible, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Google Cloud（付费）"
                                                   Grid.ColumnSpan="3"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8" />

                                        <TextBlock Grid.Row="1"
                                                   Text="Project ID"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1"
                                                 Grid.Column="1"
                                                 Text="{Binding GoogleProjectId, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,8" />

                                        <TextBlock Grid.Row="2"
                                                   Text="Location"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="2"
                                                 Grid.Column="1"
                                                 Text="{Binding GoogleLocation, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,8" />

                                        <TextBlock Grid.Row="3"
                                                   Text="Service Account"
                                                   VerticalAlignment="Center" />
                                        <TextBox Grid.Row="3"
                                                 Grid.Column="1"
                                                 Text="{Binding GoogleServiceAccountJsonPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,0,8,0" />
                                        <StackPanel Grid.Row="3"
                                                    Grid.Column="2"
                                                    Orientation="Horizontal">
                                            <Button Content="浏览..."
                                                    Margin="0,0,8,0"
                                                    Command="{Binding BrowseGoogleServiceAccountCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Padding="10,8"
                Background="#F7F7F7"
                BorderBrush="#E3E3E3"
                BorderThickness="1"
                CornerRadius="6">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#43546A"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </DockPanel>
</Window>
