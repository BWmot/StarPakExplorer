<Window x:Class="StarPakExplorer.UI.TranslationWindow"
        x:Name="TranslationWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="翻译精修工具"
        Width="1300"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- ── Toolbar / Path Selection ── -->
        <Border DockPanel.Dock="Top"
                Padding="10,8"
                Background="#F0F4F8"
                BorderBrush="#D0D7DE"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Path Inputs -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>

                    <!-- Mod Path -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Mod 解包目录:"
                               VerticalAlignment="Center"
                               Foreground="#43546A"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding ModPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Height="26"
                             Margin="0,0,4,0"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Content="..."
                            Command="{Binding BrowseModPathCommand}"
                            Width="30"
                            Height="26"
                            VerticalAlignment="Center"
                            ToolTip="选择已解包的 Mod 目录" />

                    <!-- Output Path -->
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="输出目录:"
                               VerticalAlignment="Center"
                               Foreground="#43546A"
                               FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"
                             Height="26"
                             Margin="0,0,4,0"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Button Grid.Row="1" Grid.Column="2"
                            Content="..."
                            Command="{Binding BrowseOutputPathCommand}"
                            Width="30"
                            Height="26"
                            VerticalAlignment="Center"
                            ToolTip="选择输出目录" />
                </Grid>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Button Content="📦 加载 Mod"
                            Command="{Binding LoadModCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0" />
                    <Button Content="🤖 单条翻译"
                            Command="{Binding TranslateCurrentEntryCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="使用 API 翻译当前选中的条目" />
                    <Button Content="🤖 批量翻译"
                            Command="{Binding BatchTranslateCommand}"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            ToolTip="使用 API 批量翻译所有未翻译的字段" />
                    <Button Content="📤 导出翻译 Mod"
                            Command="{Binding ExportCommand}"
                            Width="120"
                            Height="32" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Status Bar ── -->
        <Border DockPanel.Dock="Bottom"
                Padding="10,6"
                Background="#E8ECF0"
                BorderBrush="#D0D7DE"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ProgressText}"
                           Foreground="#0A6EB4"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#43546A"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ── Main Content ── -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Metadata Section -->
            <GroupBox Grid.Row="0" Header="翻译 Mod 元数据" 
                      Padding="10" 
                      Margin="0,0,0,10"
                      BorderBrush="#D0D7DE">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,8">
                        <TextBlock Text="Mod 名称 *" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding Metadata.ModName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8">
                        <TextBlock Text="友好名称" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding Metadata.FriendlyName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                        <TextBlock Text="作者" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding Metadata.Author, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="原始 Mod 名称" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding OriginalModName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="描述" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding Metadata.Description, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,0">
                        <TextBlock Text="优先级" 
                                   Foreground="#43546A" 
                                   FontSize="12" 
                                   Margin="0,0,0,2" />
                        <TextBox Text="{Binding Metadata.Priority, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="26" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Translation Grid -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="280" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Entry List -->
                <Border Grid.Column="0"
                        BorderBrush="#D0D7DE"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="White">
                    <DockPanel>
                        <!-- Search + Filter -->
                        <Border DockPanel.Dock="Top"
                                Padding="8"
                                Background="#F6F8FA"
                                BorderBrush="#D0D7DE"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right"
                                          Content="仅未翻译"
                                          IsChecked="{Binding ShowOnlyUntranslated}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,0" />
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="26"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>

                        <!-- Entry List -->
                        <ListBox ItemsSource="{Binding Entries}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 DisplayMemberPath="ItemName"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="Transparent"
                              ShowsPreview="True"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" />

                <!-- Right Panel: Translation Fields + Engine Config -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TabControl Grid.Row="0">
                        <TabItem Header="翻译字段">
                            <Border BorderBrush="#D0D7DE"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Background="White">
                                <DockPanel>
                                    <!-- Header -->
                                    <Border DockPanel.Dock="Top"
                                            Padding="10,8"
                                            Background="#F6F8FA"
                                            BorderBrush="#D0D7DE"
                                            BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Foreground="#666">
                                                <Run Text="文件:" />
                                                <Run Text="{Binding SelectedEntry.RelativePath, Mode=OneWay, FallbackValue=未选择}"
                                                     Foreground="#0A6EB4" />
                                            </TextBlock>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="14"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding SelectedEntry.ItemName, Mode=OneWay, FallbackValue=请选择左侧条目}" />
                                            </TextBlock>
                                        </DockPanel>
                                    </Border>

                                    <!-- Translation Fields -->
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SelectedEntry.FieldViewModels}"
                                                      Margin="10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8"
                                                            Padding="8"
                                                            BorderBrush="#E5E7EB"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Background="#FAFBFC">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <!-- Field Label -->
                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#0A6EB4"
                                                                       Margin="0,0,0,4" />

                                                            <!-- Original Text -->
                                                            <Border Grid.Row="1"
                                                                    Background="#F0F0F0"
                                                                    Padding="8,6"
                                                                    CornerRadius="3"
                                                                    Margin="0,0,0,6">
                                                                <TextBlock Text="{Binding OriginalValue}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="#555" />
                                                            </Border>

                                                            <!-- Translation Input -->
                                                            <TextBox Grid.Row="2"
                                                                     Text="{Binding TranslatedValue, UpdateSourceTrigger=PropertyChanged}"
                                                                     TextWrapping="Wrap"
                                                                     AcceptsReturn="True"
                                                                     MinHeight="30"
                                                                     MaxHeight="120"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     BorderBrush="#B0B8C4" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </TabItem>

                        <TabItem Header="引擎配置">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <Border Padding="12"
                                            Background="#F7F9FC"
                                            BorderBrush="#DDE3EE"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="翻译引擎"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="当前引擎"
                                                           Width="84"
                                                           VerticalAlignment="Center" />
                                                <ComboBox Width="220"
                                                          ItemsSource="{Binding EngineOptions}"
                                                          SelectedItem="{Binding SelectedEngine}" />
                                            </StackPanel>
                                            <TextBlock Text="选择 OpenAI 或 Google Cloud Translation。配置完引擎参数后即可使用单条/批量翻译。"
                                                       Foreground="#667"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="12"
                                            Background="#F7F9FC"
                                            BorderBrush="#DDE3EE"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="OpenAI"
                                                       Grid.ColumnSpan="3"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />

                                            <TextBlock Grid.Row="1"
                                                       Text="API Key"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Text="{Binding OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,8" />

                                            <TextBlock Grid.Row="2"
                                                       Text="Model"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Row="2"
                                                        Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Margin="0,0,8,0">
                                                <TextBox Width="180"
                                                         Text="{Binding OpenAiModel, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="0,0,8,0" />
                                                <TextBox Width="320"
                                                         Text="{Binding OpenAiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2"
                                                       Grid.Column="2"
                                                       Text="Base URL"
                                                       VerticalAlignment="Center"
                                                       Foreground="#667" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="12"
                                            Background="#F7F9FC"
                                            BorderBrush="#DDE3EE"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Google"
                                                       Grid.ColumnSpan="3"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />

                                            <TextBlock Grid.Row="1"
                                                       Text="Project ID"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Row="1"
                                                     Grid.Column="1"
                                                     Text="{Binding GoogleProjectId, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,8" />

                                            <TextBlock Grid.Row="2"
                                                       Text="Location"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Row="2"
                                                     Grid.Column="1"
                                                     Text="{Binding GoogleLocation, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,8" />

                                            <TextBlock Grid.Row="3"
                                                       Text="Service Account"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Row="3"
                                                     Grid.Column="1"
                                                     Text="{Binding GoogleServiceAccountJsonPath, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" />
                                            <StackPanel Grid.Row="3"
                                                        Grid.Column="2"
                                                        Orientation="Horizontal">
                                                <Button Content="浏览..."
                                                        Margin="0,0,8,0"
                                                        Command="{Binding BrowseGoogleServiceAccountCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
